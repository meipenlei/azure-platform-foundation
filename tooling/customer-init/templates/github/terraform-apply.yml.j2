name: Terraform Apply - Level 0

on:
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

env:
  TF_IN_AUTOMATION: "true"
  TF_INPUT: "false"
  AZURE_CORE_OUTPUT: "none"

defaults:
  run:
    working-directory: levels/level0/bootstrap

jobs:
  apply:
    name: Terraform Apply
    runs-on: ubuntu-24.04

    environment:
      name: apf-level0

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: "[[ terraform_version ]]"

      - name: Azure login with Apply identity
        uses: azure/login@v3
        with:
          client-id: ${{ vars.AZURE_APPLY_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}

      - name: Terraform init
        run: |
          terraform init \
            -backend-config=backend.hcl \
            -backend-config="use_cli=true"

      - name: Wait for Azure control-plane RBAC propagation
        shell: bash
        run: |
          resource_group_name="$(terraform output -raw resource_group_name)"

          for attempt in {1..60}; do
            if az group show \
              --name "$resource_group_name" \
              --subscription "${{ vars.AZURE_SUBSCRIPTION_ID }}" \
              --only-show-errors \
              --output none 2>/dev/null; then
              echo "[PASS] Azure control-plane RBAC is effective."
              exit 0
            fi

            echo "Azure control-plane RBAC is not effective yet; retrying..."
            sleep 10
          done

          echo "[ERROR] Azure control-plane RBAC did not become effective within 10 minutes." >&2
          exit 1


      - name: Terraform format check
        run: terraform fmt -check -recursive

      - name: Terraform validate
        run: terraform validate

      - name: Terraform plan
        run: |
          terraform plan \
            -lock-timeout=5m \
            -out=level0.tfplan

      - name: Terraform apply
        run: |
          terraform apply \
            -auto-approve \
            level0.tfplan
