{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apf:schema:foundation:0.1",
  "title": "Azure Platform Foundation Version Configuration",
  "description": "Defines the Azure Platform Foundation version used by a customer implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "foundation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1",
      "description": "Version of this configuration schema."
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "description": "Pinned Azure Platform Foundation release version."
        }
      }
    }
  }
}